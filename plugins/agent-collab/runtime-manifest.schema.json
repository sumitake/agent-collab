{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sumitake/agent-collab/runtime-manifest.schema.json",
  "title": "agent-collab signed direct native runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "contract_version",
    "wire_contract",
    "wire_contract_sha256",
    "channel",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "protocol_version": {"const": 5},
    "contract_version": {"const": 4},
    "wire_contract_sha256": {
      "const": "a675807e0ff5f0544d7cc9d659914ce2dadac9be8efd0fb56635815e5c3e842a"
    },
    "wire_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$defs",
        "content_frame",
        "logical_action_timeout_modes",
        "logical_actions",
        "logical_agents",
        "routing_request",
        "routing_source_sha256",
        "runtime_protocol_version",
        "schema_version",
        "terminal_planning_record"
      ],
      "properties": {
        "schema_version": {"const": 12},
        "runtime_protocol_version": {"const": 5},
        "routing_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logical_action_timeout_modes": {"type": "object", "minProperties": 1},
        "logical_actions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture.conceptual",
              "architecture.repository",
              "codegen.repository",
              "context.documents.extract",
              "context.documents.intent",
              "context.documents.reason",
              "context.repository.extract",
              "context.repository.reason",
              "frontend_codegen.repository",
              "frontend_review.repository",
              "governance.repository",
              "review.repository"
            ]
          }
        },
        "logical_agents": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "alibaba",
              "claude",
              "codex",
              "deepseek",
              "gemini",
              "grok",
              "moonshot",
              "zhipu"
            ]
          }
        },
        "routing_request": {"type": "object", "minProperties": 1},
        "content_frame": {"type": "object", "minProperties": 1},
        "terminal_planning_record": {"type": "object", "minProperties": 1},
        "$defs": {"type": "object"}
      }
    },
    "channel": {"const": "production"},
    "artifacts": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["arch"],
            "properties": {"arch": {"const": "arm64"}}
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["arch"],
            "properties": {"arch": {"const": "x86_64"}}
          },
          "minContains": 0,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "arch": {"const": "arm64"},
              "path": {"const": "runtime/darwin-arm64/agent-collab-runtime.bundle"},
              "files": {
                "items": {
                  "properties": {"architecture": {"const": "arm64"}}
                }
              }
            }
          },
          {
            "properties": {
              "arch": {"const": "x86_64"},
              "path": {"const": "runtime/darwin-x86_64/agent-collab-runtime.bundle"},
              "files": {
                "items": {
                  "properties": {"architecture": {"const": "x86_64"}}
                }
              }
            }
          }
        ],
        "required": [
          "platform",
          "arch",
          "kind",
          "minimum_macos",
          "path",
          "entrypoint",
          "size",
          "sha256",
          "provider_runtime_version",
          "wire_contract_sha256",
          "signing",
          "files"
        ],
        "properties": {
          "platform": {"const": "darwin"},
          "arch": {"enum": ["arm64", "x86_64"]},
          "kind": {"const": "standalone_bundle"},
          "minimum_macos": {"const": "14.0"},
          "path": {
            "enum": [
              "runtime/darwin-arm64/agent-collab-runtime.bundle",
              "runtime/darwin-x86_64/agent-collab-runtime.bundle"
            ]
          },
          "entrypoint": {"const": "agent-collab-runtime"},
          "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provider_runtime_version": {"const": "5.0.5"},
          "wire_contract_sha256": {"const": "a675807e0ff5f0544d7cc9d659914ce2dadac9be8efd0fb56635815e5c3e842a"},
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "contains": {
              "type": "object",
              "required": ["role"],
              "properties": {"role": {"const": "entrypoint"}}
            },
            "minContains": 1,
            "maxContains": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "if": {
                "properties": {"role": {"const": "entrypoint"}},
                "required": ["role"]
              },
              "then": {
                "properties": {"path": {"const": "agent-collab-runtime"}}
              },
              "required": [
                "path",
                "role",
                "install_mode",
                "size",
                "sha256",
                "macho_type",
                "architecture",
                "minimum_macos",
                "signing_profile"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
                "role": {"enum": ["entrypoint", "runtime_library"]},
                "install_mode": {"const": 320},
                "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "macho_type": {"enum": ["executable", "dylib", "bundle"]},
                "architecture": {"enum": ["arm64", "x86_64"]},
                "minimum_macos": {"const": "14.0"},
                "signing_profile": {"const": "production_developer_id"}
              }
            }
          },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "identity",
              "team_id",
              "require_notarization",
              "hardened_runtime",
              "secure_timestamp"
            ],
            "properties": {
              "mode": {"const": "developer_id"},
              "identity": {"type": "string", "minLength": 1},
              "team_id": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
              "require_notarization": {"const": true},
              "hardened_runtime": {"const": true},
              "secure_timestamp": {"const": true}
            }
          }
        }
      }
    }
  }
}
