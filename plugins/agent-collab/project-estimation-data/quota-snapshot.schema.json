{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "quota-snapshot.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "policy_version", "policy_sha256", "retrieved_date", "providers", "operator_notification_required", "material_unpriced", "uncertainty_basis_points"],
  "properties": {"schema_version": {"const": 1}, "kind": {"const": "quota"}, "policy_version": {"$ref": "#/$defs/version"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "retrieved_date": {"$ref": "#/$defs/date"}, "providers": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 100, "patternProperties": {"^[A-Za-z0-9._:-]{1,128}$": {"$ref": "#/$defs/provider"}}}, "operator_notification_required": {"type": "boolean"}, "material_unpriced": {"type": "boolean"}, "uncertainty_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}},
  "$defs": {
    "date": {"type": "string", "format": "date"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "record": {"type": "object", "additionalProperties": false, "required": ["record_id", "model", "modality", "tier", "limit_kind", "limit_value", "window_seconds", "cooldown_seconds", "modifiers", "approved_value_sha256"], "properties": {"record_id": {"type": "string", "maxLength": 128}, "model": {"type": "string", "maxLength": 128}, "modality": {"type": "string", "maxLength": 128}, "tier": {"type": "string", "maxLength": 128}, "limit_kind": {"type": "string", "maxLength": 64}, "limit_value": {"type": "integer", "minimum": 0}, "window_seconds": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}, "cooldown_seconds": {"type": "integer", "minimum": 0}, "modifiers": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}}, "approved_value_sha256": {"$ref": "#/$defs/sha256"}}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["provider", "status", "retrieved_date", "last_successful_official_date", "original_last_good_date", "values", "value_sha256", "source_url_sha256", "final_url_sha256", "redirect_chain_sha256", "content_type", "elapsed_class", "failure_class", "material_share_basis_points"], "properties": {"provider": {"type": "string", "maxLength": 128}, "status": {"enum": ["official", "estimated_stale", "review_required", "unpriced", "unknown"]}, "retrieved_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "last_successful_official_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "original_last_good_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "values": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/record"}}, "value_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "source_url_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "final_url_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "redirect_chain_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "content_type": {"anyOf": [{"type": "string", "maxLength": 128}, {"type": "null"}]}, "elapsed_class": {"anyOf": [{"type": "string", "maxLength": 128}, {"type": "null"}]}, "failure_class": {"anyOf": [{"type": "string", "maxLength": 128}, {"type": "null"}]}, "material_share_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}}}
  }
}
