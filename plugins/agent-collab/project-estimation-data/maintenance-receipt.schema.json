{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maintenance-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "estimator_method_version", "calibration_policy_version", "calibration_policy_sha256", "pricing_policy_version", "pricing_policy_sha256", "pricing_registry_sha256", "quota_registry_sha256", "pricing_material_unpriced_threshold_basis_points", "seed", "repository_sha256", "collection_cutoff_date", "collection_result_sha256", "linkage_manifest_sha256", "completion_evidence_scope", "source_cutoff_date", "generated_date", "calibration_status", "original_calibration_date", "source_manifest_sha256", "calibration_candidate_sha256", "calibration_source_receipt_sha256", "calibration_state", "calibration_baseline_receipt_sha256", "backtest_outcome", "pricing_result_sha256", "quota_result_sha256", "notification_result", "release_manifest_sha256", "inventory", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 3}, "version": {"type": "string", "maxLength": 64}, "estimator_method_version": {"const": "empirical-v3"}, "calibration_policy_version": {"type": "string", "maxLength": 64}, "calibration_policy_sha256": {"$ref": "#/$defs/sha256"}, "pricing_policy_version": {"type": "string", "maxLength": 64}, "pricing_policy_sha256": {"$ref": "#/$defs/sha256"}, "pricing_registry_sha256": {"$ref": "#/$defs/sha256"}, "quota_registry_sha256": {"$ref": "#/$defs/sha256"}, "pricing_material_unpriced_threshold_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "repository_sha256": {"$ref": "#/$defs/sha256"}, "collection_cutoff_date": {"$ref": "#/$defs/date"}, "collection_result_sha256": {"$ref": "#/$defs/sha256"}, "linkage_manifest_sha256": {"$ref": "#/$defs/sha256"}, "completion_evidence_scope": {"const": "github_merged_or_earlier"}, "source_cutoff_date": {"$ref": "#/$defs/date"}, "generated_date": {"$ref": "#/$defs/date"}, "calibration_status": {"enum": ["fresh", "last_good"]}, "original_calibration_date": {"$ref": "#/$defs/date"}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "calibration_candidate_sha256": {"$ref": "#/$defs/sha256"}, "calibration_source_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "calibration_state": {"enum": ["bootstrap", "promoted"]}, "calibration_baseline_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "backtest_outcome": {"$ref": "#/$defs/backtest"}, "pricing_result_sha256": {"$ref": "#/$defs/sha256"}, "quota_result_sha256": {"$ref": "#/$defs/sha256"}, "notification_result": {"enum": ["not_required", "delivered"]}, "release_manifest_sha256": {"$ref": "#/$defs/sha256"}, "inventory": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/inventory"}}, "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "date": {"type": "string", "format": "date"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "size"], "properties": {"name": {"type": "string", "maxLength": 128}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0, "maximum": 1048576}}},
    "backtest": {"type": "object", "additionalProperties": false, "required": ["evaluation_mode", "policy_result", "baseline_duration_comparison", "baseline_token_comparison", "warning_codes"], "properties": {"evaluation_mode": {"enum": ["informational", "promotion_gate"]}, "policy_result": {"enum": ["not_required", "passed"]}, "baseline_duration_comparison": {"enum": ["performed", "not_applicable"]}, "baseline_token_comparison": {"enum": ["performed", "not_applicable", "no_shared_token_class"]}, "warning_codes": {"type": "array", "uniqueItems": true, "maxItems": 18, "items": {"enum": ["baseline_token_no_shared_class", "duration_drift", "duration_regression", "empty_holdout", "insufficient_complete_token_holdout:enhancement", "insufficient_complete_token_holdout:greenfield", "insufficient_complete_token_training:enhancement", "insufficient_complete_token_training:greenfield", "insufficient_duration_holdout:enhancement", "insufficient_duration_holdout:greenfield", "missing_training_root:enhancement", "missing_training_root:greenfield", "p80_coverage", "p95_coverage", "sparse_holdout:enhancement", "sparse_holdout:greenfield", "token_drift", "token_regression"]}}}}
  }
}
