{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggregate-prior.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "estimator_method_version", "generated_date", "source_cutoff_date", "policy_version", "policy_sha256", "seed", "source_manifest_sha256", "nodes"],
  "properties": {
    "schema_version": {"const": 1}, "estimator_method_version": {"$ref": "#/$defs/version"}, "generated_date": {"$ref": "#/$defs/date"}, "source_cutoff_date": {"$ref": "#/$defs/date"},
    "policy_version": {"$ref": "#/$defs/version"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "date": {"type": "string", "format": "date"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "estimator_method_version", "generated_date", "source_cutoff_date", "hierarchy_node", "sample_count", "effective_sample_size", "aggregate_sha256", "release_manifest_sha256"],
      "properties": {
        "schema_version": {"const": 1}, "estimator_method_version": {"$ref": "#/$defs/version"}, "generated_date": {"$ref": "#/$defs/date"}, "source_cutoff_date": {"$ref": "#/$defs/date"}, "hierarchy_node": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, "fallback_parent": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, {"type": "null"}]},
        "sample_count": {"type": "integer", "minimum": 20, "maximum": 1000000000}, "effective_sample_size": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "aggregate_sha256": {"$ref": "#/$defs/sha256"}, "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_eras": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/version"}}, "phase_duration_quantiles": {"$ref": "#/$defs/quantiles"}, "token_class_quantiles": {"$ref": "#/$defs/quantiles"}, "rework_review_quantiles": {"$ref": "#/$defs/quantiles"}, "wait_class_quantiles": {"$ref": "#/$defs/quantiles"}, "calibration_quality": {"$ref": "#/$defs/metrics"}, "drift_indicators": {"$ref": "#/$defs/metrics"}, "uncertainty_floors": {"$ref": "#/$defs/metrics"}, "pricing_snapshot": {"$ref": "#/$defs/pricing"}
      }
    },
    "quantiles": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["p50", "p80", "p95"], "properties": {"phase": {"type": "string"}, "token_class": {"type": "string"}, "kind": {"type": "string"}, "wait_class": {"type": "string"}, "p50": {"type": "integer", "minimum": 0}, "p80": {"type": "integer", "minimum": 0}, "p95": {"type": "integer", "minimum": 0}}}},
    "metrics": {"type": "object", "additionalProperties": false, "maxProperties": 10, "properties": {"holdout_count": {"type": "integer", "minimum": 0}, "p80_coverage_basis_points": {"type": "integer", "minimum": 0}, "p95_coverage_basis_points": {"type": "integer", "minimum": 0}, "duration_drift_basis_points": {"type": "integer", "minimum": 0}, "token_drift_basis_points": {"type": "integer", "minimum": 0}, "duration_basis_points": {"type": "integer", "minimum": 0}, "token_basis_points": {"type": "integer", "minimum": 0}}},
    "pricing": {"type": "object", "additionalProperties": false, "required": ["sha256", "retrieved_date", "status"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "retrieved_date": {"$ref": "#/$defs/date"}, "status": {"enum": ["official", "proxy", "estimated", "estimated_stale", "unpriced"]}}}
  }
}
