{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggregate-prior.schema.json",
  "type": "object", "additionalProperties": false, "maxProperties": 13,
  "required": ["schema_version", "estimator_method_version", "generated_date", "source_cutoff_date", "policy_version", "policy_sha256", "seed", "source_manifest_sha256", "calibration_state", "excluded_observation_count_floor", "exclusion_count_rounding", "limitations", "nodes"],
  "properties": {
    "schema_version": {"const": 2}, "estimator_method_version": {"const": "empirical-v3"}, "generated_date": {"$ref": "#/$defs/date"}, "source_cutoff_date": {"$ref": "#/$defs/date"}, "policy_version": {"$ref": "#/$defs/version"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "calibration_state": {"enum": ["bootstrap", "promoted"]}, "excluded_observation_count_floor": {"type": "integer", "minimum": 0, "multipleOf": 20}, "exclusion_count_rounding": {"const": "floor_to_public_k"}, "limitations": {"type": "array", "uniqueItems": true, "maxItems": 11, "items": {"enum": ["actual_marginal_cash_unavailable", "bootstrap_descriptive_only", "enhancement_prior_unavailable", "git_event_fallback_only", "greenfield_prior_unavailable", "holdout_unavailable", "informational_backtest_below_policy", "quota_delay_prior_unavailable", "rework_review_prior_unavailable", "token_prior_unavailable", "wait_class_prior_unavailable"]}}, "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^(?:(?:(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:(?:(?!0000)[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))|(?:0[48]|[2468][048]|[13579][26])00)-02-29))$"}, "version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node": {"type": "object", "additionalProperties": false, "maxProperties": 20, "required": ["schema_version", "estimator_method_version", "generated_date", "source_cutoff_date", "hierarchy_node", "sample_count", "effective_sample_size", "aggregate_sha256", "release_manifest_sha256", "metric_support"], "properties": {
      "schema_version": {"const": 1}, "estimator_method_version": {"const": "empirical-v3"}, "generated_date": {"$ref": "#/$defs/date"}, "source_cutoff_date": {"$ref": "#/$defs/date"}, "hierarchy_node": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, "fallback_parent": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, {"type": "null"}]}, "sample_count": {"type": "integer", "minimum": 20, "maximum": 1000000000}, "effective_sample_size": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "aggregate_sha256": {"$ref": "#/$defs/sha256"}, "release_manifest_sha256": {"$ref": "#/$defs/sha256"}, "metric_support": {"$ref": "#/$defs/metric_support"},
      "source_eras": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/version"}}, "phase_duration_quantiles": {"$ref": "#/$defs/phase_quantiles"}, "token_class_quantiles": {"$ref": "#/$defs/token_quantiles"}, "rework_review_quantiles": {"$ref": "#/$defs/rework_quantiles"}, "wait_class_quantiles": {"$ref": "#/$defs/wait_quantiles"}, "calibration_quality": {"$ref": "#/$defs/calibration_quality"}, "drift_indicators": {"$ref": "#/$defs/drift_indicators"}, "uncertainty_floors": {"$ref": "#/$defs/uncertainty_floors"}, "pricing_snapshot": {"$ref": "#/$defs/pricing_snapshot"}
    }},
    "phase_quantiles": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/phase_quantile"}}, "token_quantiles": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/token_quantile"}}, "rework_quantiles": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/rework_quantile"}}, "wait_quantiles": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/wait_quantile"}},
    "phase_quantile": {"type": "object", "additionalProperties": false, "maxProperties": 4, "required": ["phase", "p50", "p80", "p95"], "properties": {"phase": {"type": "string", "enum": ["overall", "primary", "delegation", "review", "test", "release", "deployment", "rework"]}, "p50": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p80": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p95": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "token_quantile": {"type": "object", "additionalProperties": false, "maxProperties": 4, "required": ["token_class", "p50", "p80", "p95"], "properties": {"token_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "p50": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p80": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p95": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "rework_quantile": {"type": "object", "additionalProperties": false, "maxProperties": 4, "required": ["kind", "p50", "p80", "p95"], "properties": {"kind": {"type": "string", "enum": ["review", "rework"]}, "p50": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p80": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p95": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "wait_quantile": {"type": "object", "additionalProperties": false, "maxProperties": 4, "required": ["wait_class", "p50", "p80", "p95"], "properties": {"wait_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "p50": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p80": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p95": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "metric_support_record": {"type": "object", "additionalProperties": false, "required": ["status", "eligible_count"], "properties": {"status": {"enum": ["published", "suppressed_below_k", "unavailable"]}, "eligible_count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 1000000000}, {"type": "null"}]}}},
    "metric_support": {"type": "object", "additionalProperties": false, "required": ["actual_marginal_cash", "focused_duration", "quota_delay", "rework_review", "token_usage", "wait_class"], "properties": {"actual_marginal_cash": {"$ref": "#/$defs/metric_support_record"}, "focused_duration": {"$ref": "#/$defs/metric_support_record"}, "quota_delay": {"$ref": "#/$defs/metric_support_record"}, "rework_review": {"$ref": "#/$defs/metric_support_record"}, "token_usage": {"$ref": "#/$defs/metric_support_record"}, "wait_class": {"$ref": "#/$defs/metric_support_record"}}},
    "calibration_quality": {"type": "object", "additionalProperties": false, "maxProperties": 3, "properties": {"holdout_count": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p80_coverage_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "p95_coverage_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}}}, "drift_indicators": {"type": "object", "additionalProperties": false, "maxProperties": 2, "properties": {"duration_drift_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "token_drift_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}}}, "uncertainty_floors": {"type": "object", "additionalProperties": false, "maxProperties": 2, "properties": {"duration_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "token_basis_points": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "pricing_snapshot": {"type": "object", "additionalProperties": false, "maxProperties": 3, "required": ["sha256", "retrieved_date", "status"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "retrieved_date": {"$ref": "#/$defs/date"}, "status": {"enum": ["official", "estimated_stale", "unpriced"]}}}
  }
