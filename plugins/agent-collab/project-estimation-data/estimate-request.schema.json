{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "estimate-request.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "invocation_source", "artifact_scope_hash", "auto_invocation_depth", "project_type", "maturity", "requested_completion_boundary", "phases", "dependency_edges", "persistence_consent"],
  "properties": {
    "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/identifier"}, "artifact_kind": {"enum": ["standalone", "implementation_design", "implementation_plan"]}, "invocation_source": {"enum": ["explicit", "situational_auto", "composed_checkpoint"]}, "artifact_scope_hash": {"$ref": "#/$defs/sha256"}, "auto_invocation_depth": {"type": "integer", "minimum": 0, "maximum": 10}, "mode": {"enum": ["greenfield", "enhancement", "reconcile", "detail_query", "automatic"]}, "project_type": {"enum": ["greenfield", "enhancement"]}, "maturity": {"enum": ["new", "established", "legacy", "unknown"]}, "requested_completion_boundary": {"$ref": "#/$defs/boundary"}, "phases": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/phase"}}, "dependency_edges": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/edge"}}, "reusable_classification": {"enum": ["reusable_core", "first_client", "repeat_client", "unknown"]}, "subsystems": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}, "integrations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}, "environments": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}, "migration_burden": {"enum": ["none", "low", "medium", "high", "unknown"]}, "requirements": {"$ref": "#/$defs/requirements"}, "agent_roles": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/agent_role"}}, "phase_ownership": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/ownership"}}, "review_gates": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/gate"}}, "operator_decisions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/lead"}}, "external_leads": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/lead"}}, "concurrency": {"$ref": "#/$defs/concurrency"}, "provider_quota_constraints": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/quota"}}, "assumptions": {"type": "array", "maxItems": 1000, "items": {"type": "string", "maxLength": 512}}, "exclusions": {"type": "array", "maxItems": 1000, "items": {"type": "string", "maxLength": 512}}, "scope": {"$ref": "#/$defs/legacy_scope"}, "persistence_consent": {"type": "boolean"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "boundary": {"enum": ["planned", "source_present", "executed_unverified", "gate_verified", "merged", "released", "deployed", "operationally_verified"]},
    "phase": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "owner", "depends_on"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"$ref": "#/$defs/identifier"}, "owner": {"enum": ["autonomous_agent", "operator", "vendor_external"]}, "depends_on": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}, "duration_class": {"enum": ["short", "medium", "long", "unknown"]}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/identifier"}, "to": {"$ref": "#/$defs/identifier"}}},
    "requirements": {"type": "object", "additionalProperties": false, "properties": {"security_privacy": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "reliability_load": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "observability": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "documentation": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "ci_cd": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "rollout_rollback": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}, "evaluation": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/identifier"}}}},
    "agent_role": {"type": "object", "additionalProperties": false, "required": ["role", "route"], "properties": {"role": {"$ref": "#/$defs/identifier"}, "route": {"$ref": "#/$defs/identifier"}, "model": {"$ref": "#/$defs/identifier"}}}, "ownership": {"type": "object", "additionalProperties": false, "required": ["phase_id", "owner"], "properties": {"phase_id": {"$ref": "#/$defs/identifier"}, "owner": {"enum": ["autonomous_agent", "operator", "vendor_external"]}}}, "gate": {"type": "object", "additionalProperties": false, "required": ["phase_id", "kind"], "properties": {"phase_id": {"$ref": "#/$defs/identifier"}, "kind": {"$ref": "#/$defs/identifier"}, "lead": {"enum": ["agent", "operator", "vendor_external"]}}}, "lead": {"type": "object", "additionalProperties": false, "required": ["name", "kind"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "kind": {"enum": ["operator", "vendor_external", "dependency"]}}},
    "concurrency": {"type": "object", "additionalProperties": false, "properties": {"max_workers": {"type": "integer", "minimum": 1, "maximum": 1000}, "known_parallel": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}}}, "quota": {"type": "object", "additionalProperties": false, "required": ["provider", "limit_kind", "limit_value"], "properties": {"provider": {"$ref": "#/$defs/identifier"}, "limit_kind": {"$ref": "#/$defs/identifier"}, "limit_value": {"type": "integer", "minimum": 0}, "window_seconds": {"type": ["integer", "null"], "minimum": 1}, "cooldown_seconds": {"type": "integer", "minimum": 0}}},
    "legacy_scope": {"type": "object", "additionalProperties": false, "properties": {"phases": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/phase"}}, "dependencies": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/edge"}}, "constraints": {"type": "array", "maxItems": 1000, "items": {"type": "string", "maxLength": 256}}, "completion_evidence": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}}}
  }
}
