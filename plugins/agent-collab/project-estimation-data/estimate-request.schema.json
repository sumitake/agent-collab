{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estimate-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "project_type", "requested_completion_boundary", "scope", "persistence_consent"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/identifier"},
    "mode": {"enum": ["greenfield", "enhancement", "reconcile", "detail_query", "automatic"]},
    "project_type": {"enum": ["greenfield", "enhancement"]},
    "requested_completion_boundary": {"$ref": "#/$defs/boundary"},
    "scope": {"$ref": "#/$defs/scope"},
    "persistence_consent": {"type": "boolean"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "depth": {"type": "integer", "minimum": 0, "maximum": 10}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "boundary": {"enum": ["planned", "source_present", "executed_unverified", "gate_verified", "merged", "released", "deployed", "operationally_verified"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "phases": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/phase"}},
        "dependencies": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/dependency"}},
        "constraints": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/constraint"}},
        "completion_evidence": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "phase": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "owner", "depends_on"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"$ref": "#/$defs/identifier"}, "owner": {"enum": ["autonomous_agent", "operator", "vendor_external"]}, "depends_on": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/identifier"}}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/identifier"}, "to": {"$ref": "#/$defs/identifier"}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"$ref": "#/$defs/identifier"}, "value": {"type": "integer", "minimum": 0, "maximum": 1000000000}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "identifier"], "properties": {"kind": {"$ref": "#/$defs/identifier"}, "identifier": {"$ref": "#/$defs/identifier"}}}
  }
}
